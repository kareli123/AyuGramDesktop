// Apple Liquid Glass — Dark
//
// An iOS/macOS-inspired dark palette for AyuGram / Telegram Desktop:
// graphite panels, iOS system blue accent (#0A84FF), iMessage-style blue
// outgoing bubbles and hairline separators.
//
// HOW TO USE (no build required):
//   Settings -> Chat Settings -> Themes -> (three dots) -> "Create from file"
//   ...or simply drag this .tdesktop-palette file onto the app window.
// Any key not listed here falls back to the default night theme.
//
// Colors are RGB (#rrggbb) or RGBA (#rrggbbaa) — alpha is the LAST byte.

//// GLOBAL WINDOW ////
windowBg: #1c1c1e;                 // main graphite background
windowFg: #ffffff;                 // primary text
windowBgOver: #2c2c2e;             // hovered rows / panels
windowBgRipple: #3a3a3c;           // ripple on tap
windowFgOver: #ffffff;
windowSubTextFg: #98989f;          // iOS secondary label
windowSubTextFgOver: #aeaeb2;
windowBoldFg: #ffffff;
windowBoldFgOver: #ffffff;
windowActiveTextFg: #0a84ff;       // iOS system blue (links)
windowShadowFg: #000000;
windowShadowFgFallback: #1c1c1e;

windowBgActive: #0a84ff;           // accent fill
windowFgActive: #ffffff;
windowActiveTextFgActive: #ffffff;

